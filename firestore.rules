rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============ User-scoped catch records ============
    // Only the owner can read/write their own catches
    match /users/{userId}/catches/{catchId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ============ Public Feed ============
    match /publicFeed/{feedId} {
      // Anyone can read (public feed)
      allow read: if true;

      // Only the record owner can create their own feed entries
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasAll(['userId', 'species', 'date'])
                    && request.resource.data.species is string
                    && request.resource.data.species.size() <= 50;

      // Like updates: any authenticated user can update ONLY likeCount.
      // commentCount +1 is allowed for any authenticated user — it moves
      // together with a comment create (denormalized counter that removed
      // the feed's 51-read N+1). Owner can update all fields.
      allow update: if request.auth != null
                    && (
                      // Owner can update anything
                      resource.data.userId == request.auth.uid
                      ||
                      // Non-owner can only modify likeCount (increment/decrement by 1)
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
                        && request.resource.data.likeCount is int
                        && (request.resource.data.likeCount == resource.data.likeCount + 1
                            || request.resource.data.likeCount == resource.data.likeCount - 1)
                      )
                      ||
                      // ...or bump commentCount by exactly one (comment write path)
                      (
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
                        && request.resource.data.commentCount is int
                        && request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
                      )
                    );

      // Only the owner can delete
      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;

      // Comments sub-collection. NOTE: the old rule validated a `text`
      // field the client never wrote (the schema is `content`) — comment
      // creation was silently impossible against Firestore until this was
      // aligned (4차 GOAL-4).
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.keys().hasOnly(['userId', 'userDisplayName', 'content', 'createdAt'])
                      && request.resource.data.content is string
                      && request.resource.data.content.size() >= 1
                      && request.resource.data.content.size() <= 500
                      && request.resource.data.userDisplayName is string
                      && request.resource.data.userDisplayName.size() <= 30
                      && request.resource.data.createdAt is string;
        allow delete: if request.auth != null
                      && resource.data.userId == request.auth.uid;
      }
    }

    // ============ Companion Recruiting (동출 모집) ============
    // Anyone can read; writes need auth (anonymous auth counts — the app
    // signs users in anonymously before posting). Ownership is enforced
    // server-side via authorUid == request.auth.uid.
    // Known v1 limits, accepted knowingly: `contact` is world-readable by
    // design (users are told to post only shareable links), the date shape
    // regex doesn't bound how far in the future a date may be, and there is
    // no per-uid rate limit (anonymous auth is unmetered) — revisit with
    // App Check if abuse appears.
    match /companionPosts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['boatUid', 'boatName', 'port', 'date', 'seatsWanted', 'note', 'contact', 'authorUid', 'authorName', 'status', 'createdAt'])
                    && request.resource.data.keys().hasAll(['boatName', 'date', 'seatsWanted', 'note', 'contact', 'authorUid', 'authorName', 'status', 'createdAt'])
                    && (!('boatUid' in request.resource.data) || (request.resource.data.boatUid is string && request.resource.data.boatUid.size() <= 20))
                    && (!('port' in request.resource.data) || (request.resource.data.port is string && request.resource.data.port.size() <= 50))
                    && request.resource.data.createdAt is string
                    && request.resource.data.createdAt.size() <= 40
                    && request.resource.data.boatName is string
                    && request.resource.data.boatName.size() >= 1
                    && request.resource.data.boatName.size() <= 50
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
                    && request.resource.data.seatsWanted is int
                    && request.resource.data.seatsWanted >= 1
                    && request.resource.data.seatsWanted <= 20
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 300
                    && request.resource.data.contact is string
                    && request.resource.data.contact.size() <= 200
                    && request.resource.data.authorName is string
                    && request.resource.data.authorName.size() <= 30
                    && request.resource.data.status == 'open';

      // v1: owner may only close their post (no other edits)
      allow update: if request.auth != null
                    && resource.data.authorUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                    && request.resource.data.status == 'closed';

      allow delete: if request.auth != null
                    && resource.data.authorUid == request.auth.uid;
    }

    // ============ User Profiles ============
    match /userProfiles/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============ Open Run Alert Subscriptions ============
    match /openRunAlerts/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
